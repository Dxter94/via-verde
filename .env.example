# ---------------------------------------------------------------------------
# Vía Verde — environment variables
#
# Copy this file to `.env` and fill in the values. NEVER commit your real .env:
# it holds your keys. This .env.example is the only one that goes in the repo.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on.
PORT=3000

# Where the SQLite database file lives (relative paths are resolved from the
# project root). The folder must exist; it ships with a .gitkeep.
DATABASE_PATH=./data/via-verde.sqlite

# ---------------------------------------------------------------------------
# Generative-AI "coach" (OPTIONAL)
#
# If AI_API_KEY is empty, the app still works: the coach falls back to a
# built-in, rule-based message. Set these to get a personalised nudge from an
# OpenAI-compatible Chat Completions endpoint (OpenAI, Groq, OpenRouter, a
# local Ollama/LM Studio server, etc.).
# ---------------------------------------------------------------------------

# Your API key. Leave blank to run fully offline with the fallback coach.
AI_API_KEY=

# OpenAI-compatible base URL (no trailing slash). Examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1   (Ollama)
AI_BASE_URL=https://api.openai.com/v1

# Model name to use for the coach message.
AI_MODEL=gpt-4o-mini
